# HandLoan.ai — Apache config for Hostinger (copied into dist/ by the build)

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # "Page not found" must always return HTTP 404, never 200.
  # Unknown URLs already get 404 via ErrorDocument above; this also makes a direct
  # request for /404.html return 404 (REDIRECT_STATUS is empty only on direct requests,
  # so the ErrorDocument's own internal request is not caught in a loop).
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^404\.html$ - [R=404,L]

  # Old website URLs -> new pages (keeps existing links, ads and bookmarks working)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^about\.html$ /about/ [L,R=301]
  RewriteRule ^service\.html$ /services/ [L,R=301]
  RewriteRule ^career\.html$ /careers/ [L,R=301]
  RewriteRule ^contact\.html$ /contact/ [L,R=301]
  RewriteRule ^disclaimer\.html$ /disclaimer/ [L,R=301]
  RewriteRule ^t&c\.html$ /terms/ [L,R=301]
  RewriteRule ^privacy\.html$ /privacy-policy/ [L,R=301]
  RewriteRule ^refund\.html$ /refund-policy/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets never change -> cache for a year. HTML always revalidates.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Never serve app installers from the website (Meta/RBI red flag)
<FilesMatch "\.apk$">
  Require all denied
</FilesMatch>
